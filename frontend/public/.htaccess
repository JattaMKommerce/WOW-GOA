<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite existing files or directories (allows /backend/api.php and static assets to load)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all SPA pages (like /admin, /vendor, etc.) to index.html
  RewriteRule . index.html [L]
</IfModule>
